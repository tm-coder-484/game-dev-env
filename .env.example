# ---------------------------------------------------------------------------
# game-dev-env environment variables
#
# Claude Code cloud: paste the lines you need into your environment's
#   "Environment variables" box (claude.ai/code -> cloud icon -> settings).
#   See docs/CLOUD_ENVIRONMENT.md.
# Local: copy to .env and `set -a; . ./.env; set +a` (bash) before running
#   tools, or set them in your shell profile / Windows System Properties.
# ---------------------------------------------------------------------------

# --- OpenRouter (https://openrouter.ai/keys) -------------------------------
# One key for Claude, GPT, Gemini, DeepSeek, image models, etc.
# On Pro/Max cloud plans prefer an "API credential" (host: openrouter.ai) so the
# key never enters the session - then leave this unset.
OPENROUTER_API_KEY=sk-or-v1-replace-me
# Content generation (quests, lore, item tables, code help)
OPENROUTER_MODEL=anthropic/claude-sonnet-5
# In-game NPC dialogue via tools/openrouter/server.mjs - cheap and fast
OPENROUTER_NPC_MODEL=deepseek/deepseek-v4.1-flash
# Default image model for tools/openrouter/assets.mjs (HUDs, icons, textures...).
# Any OpenRouter image model works; --model overrides per call, and fragments
# are fine ("sunburst", "seedream 5 pro"). List them: assets.mjs models
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2.5-flare
# Optional house style appended to every asset prompt
# ASSET_STYLE=Grounded realistic survival game, muted palette, worn materials

# --- Toolchain versions (read by setup/install-toolchain.sh) ---------------
GODOT_VERSION=4.7.2
BLENDER_VERSION=5.2.2
# web, linux, windows, macos, android, ios, all
GODOT_TEMPLATE_PLATFORMS=web,linux,windows

# --- AI NPC server (tools/openrouter/server.mjs) ---------------------------
# PORT=8787
# HOST=127.0.0.1            # 0.0.0.0 to reach it from other devices
# AI_MAX_TOKENS=300          # hard cap per reply (cost control)
# AI_ALLOWED_MODELS=deepseek/deepseek-v4.1-flash
# AI_CORS_ORIGIN=*           # lock to your game's origin when deployed
